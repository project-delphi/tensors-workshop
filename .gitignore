# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Local browser-check dependencies. package.json and package-lock.json ARE
# committed: the navigation check runs in CI, and `npm ci` needs the lock to
# install the pinned Playwright rather than resolving a new one.
node_modules/

# uv's resolution of pyproject.toml, written on the first `uv run`. Not
# committed, deliberately. The groups there carry floors rather than pins so a
# local environment tracks Colab, which moves; a lockfile would freeze the
# teaching environment away from the one students actually get. Nothing in CI
# reads it either — every step resolves from pyproject.toml.
uv.lock

# Excel lock files
~$*.xlsx

/.quarto/

# The rendered site. Actions builds it and uploads it to Pages as an artifact
# (.github/workflows/publish.yml), so no copy of it is committed and a content
# PR carries only source. `quarto render` still writes it here, and both
# checkers read it from here: check_links.py resolves every link against it,
# and check_navigation.cjs serves it to a real browser. So render before you
# check, and expect an empty `git status` afterwards.
/docs/

# Quarto
/.luarc.json
/_freeze/
# Anchored to the source tree on purpose. An unanchored `*_files/` would also
# match Quarto's per-page resource dirs under docs/, and files git ignores are
# invisible to `git status --porcelain` — so the publish workflow's staleness
# gate would go green while Pages served a page whose assets were never
# committed.
/*_files/

# Cached archive created by the PCA notebook.
pca_data/

# Claude Code's resume checkpoint, written near a context limit. Session
# state, not source.
/.claude/RESUME.md
